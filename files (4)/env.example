# Stability AI — 25 БЕЗКОШТОВНИХ кредитів
# https://platform.stability.ai → API Key
STABILITY_API_KEY=sk-REPLACE

# Pollinations — ПОВНІСТЮ БЕЗКОШТОВНО, без ключа (автоматично)
# Не потрібен ключ — використовується автоматично як fallback

# ── ВІДЕО ───────────────────────────────────────────────────────────────

# Luma Dream Machine — 30 БЕЗКОШТОВНИХ відео/місяць
# https://lumalabs.ai → Settings → API
