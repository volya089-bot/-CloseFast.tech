# ══════════════════════════════════════════════════════════════════════
#  CloseFast Omni — Vercel Environment Variables
#  Додай у Vercel Dashboard → Project → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════════

# ── ОБОВ'ЯЗКОВІ ────────────────────────────────────────────────────────
DEV_EMAILS=volya089@gmail.com,slavikbobnar1981@gmail.com
KEY_SALT=your-random-32-char-salt-here
PWD_SALT=your-password-salt-here

# ── VERCEL KV (для зберігання ключів та юзерів) ────────────────────────
# Vercel Dashboard → Storage → Create Database → KV
KV_REST_API_URL=https://your-kv.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-token

# ── EMAIL (Resend — 100 FREE emails/day) ──────────────────────────────
# https://resend.com — безплатна реєстрація, 100 emails/день
RESEND_API_KEY=re_REPLACE

# ── STRIPE ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ══════════════════════════════════════════════════════════════════════
#  AI КЛЮЧІ — СИСТЕМНІ (юзери можуть додати свої в Settings)
#  Всі ці ключі безкоштовні! Реєструйся і встав.
# ══════════════════════════════════════════════════════════════════════

# ── ТЕКСТ / LLM ────────────────────────────────────────────────────────

# Groq — БЕЗКОШТОВНО, LLaMA 3, дуже швидко
# https://console.groq.com → Free signup → API Keys
GROQ_API_KEY=gsk_REPLACE

