# https://aistudio.google.com/apikey → Get API Key
GEMINI_API_KEY=AIzaSy_REPLACE

# OpenRouter — БЕЗКОШТОВНО, DeepSeek R1, Gemma, Phi
# https://openrouter.ai → Sign up → API Keys
OPENROUTER_API_KEY=sk-or-REPLACE

# Mistral — БЕЗКОШТОВНО
# https://console.mistral.ai → API Keys
